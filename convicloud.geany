[editor]
line_wrapping=false
line_break_column=72
auto_continue_multiline=true

[file_prefs]
final_new_line=true
ensure_convert_new_lines=false
strip_trailing_spaces=false
replace_tabs=false

[indentation]
indent_width=4
indent_type=1
indent_hard_tab_width=8
detect_indent=false
detect_indent_width=false
indent_mode=2

[project]
name=convicloud
base_path=/webs/proyectos/convicloud
description=
file_patterns=

[long line marker]
long_line_behaviour=1
long_line_column=72

[files]
current_page=-1

[VTE]
last_dir=/home/kkwet

[prjorg]
expanded_paths=/webs/proyectos/convicloud/app/Http/Controllers;/webs/proyectos/convicloud/app/Models;/webs/proyectos/convicloud/database/migrations;/webs/proyectos/convicloud/public/assets/font-awesome-4.7.0/css;/webs/proyectos/convicloud/public/assets/js;/webs/proyectos/convicloud/resources/css;/webs/proyectos/convicloud/resources/views/alumno;/webs/proyectos/convicloud/resources/views/layouts;/webs/proyectos/convicloud/resources/views/profesor;/webs/proyectos/convicloud/routes;
source_patterns=*.c;*.C;*.cpp;*.cxx;*.c++;*.cc;*.m;
header_patterns=*.h;*.H;*.hpp;*.hxx;*.h++;*.hh;
ignored_dirs_patterns=.*;CVS;
ignored_file_patterns=*.o;*.obj;*.a;*.lib;*.so;*.dll;*.lo;*.la;*.class;*.jar;*.pyc;*.mo;*.gmo;
generate_tag_prefs=0
show_empty_dirs=true
external_dirs=
